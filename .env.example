# Copia este archivo a .env.local y rellena los valores desde tu proyecto
# de Supabase: Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# service_role key (Project Settings > API). Server-only: bypassa RLS a
# propósito para leer/enviar notificaciones push entre miembros del box.
# Nunca exponerla con el prefijo NEXT_PUBLIC_ ni en código de cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# API de Claude (console.anthropic.com) — usada para extraer el WOD de una
# foto de pizarra. Nunca exponerla con el prefijo NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# Web Push (notificaciones de WOD subido y PRs). Generar con:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tucorreo@dominio.com
